{
  "name": "addonray",
  "description": "A privacy-first Firefox extension inspector with honest capability limits.",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.3-canary.20261021.1",
  "engines": {
    "bun": "1.4.4-canary.1"
  },
  "scripts": {
    "dev": "bun --bun run wxt --browser firefox --mv3",
    "prepare": "bun --bun run wxt prepare",
    "typecheck": "bun --check",
    "test": "bun test",
    "build": "bun --bun run wxt build --browser firefox --mv3",
    "package": "bun --bun run wxt zip --browser firefox --mv3 && bun run check:manifest && bun scripts/check-package.mjs",
    "test:source-build": "bun run package && bun scripts/check-source-build.mjs",
    "check:manifest": "bun scripts/check-manifest.mjs",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "bun lint --no-script --max-warnings=0",
    "check:workflows": "jactionlint --strict-exit",
    "check:toolchain": "bun scripts/check-toolchain.ts",
    "check": "bun run check:toolchain && bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run package && bun run check:workflows",
    "test:firefox": "bun run build && bun scripts/firefox-probes.mjs",
    "test:firefox:package": "bun run package && bun scripts/firefox-probes.mjs --package",
    "test:firefox-popup": "bun run build && bun scripts/firefox-popup.mjs",
    "test:firefox-popup:package": "bun run package && bun scripts/firefox-popup.mjs --package"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "jszip": "3.10.2",
    "selenium-webdriver": "4.51.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wxt": "0.21.4"
  }
}
